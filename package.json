{
  "name": "markdown-workbench-s",
  "displayName": "Markdown Workbench S",
  "description": "A feature-rich Markdown preview extension for VS Code with powerful table filtering, sorting, column tools, Mermaid, TOC, search, and source navigation.",
  "version": "1.2.0",
  "publisher": "Shinkai",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onCommand:markdownWorkbenchS.openPreview"
  ],
  "main": "extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markdownWorkbenchS.openPreview",
        "title": "Markdown Workbench S: Open Preview"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "markdownWorkbenchS.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn || resourceExtname == .txt",
          "group": "navigation@50"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownWorkbenchS.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn || resourceExtname == .txt",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "markdownWorkbenchS.openPreview",
          "when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn || resourceExtname == .txt",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "markdownWorkbenchS.openPreview",
          "when": "webviewId == markdownWorkbenchS",
          "group": "navigation"
        }
      ]
    }
  },
  "keywords": [
    "markdown",
    "table",
    "filter",
    "sorting",
    "preview",
    "mermaid",
    "documentation",
    "toc"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shinkai-dev/markdown-workbench-s.git"
  },
  "homepage": "https://github.com/shinkai-dev/markdown-workbench-s#readme",
  "bugs": {
    "url": "https://github.com/shinkai-dev/markdown-workbench-s/issues"
  }
}
